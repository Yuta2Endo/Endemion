# Заголовки для статических файлов Cloudflare Pages.
# На ответы Functions (/api/*, /title/*) этот файл не действует: там заголовки ставит functions/_lib/html.js

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000
  Content-Security-Policy: default-src 'self'; script-src 'self' https://challenges.cloudflare.com https://static.cloudflareinsights.com https://mc.yandex.ru https://yastatic.net; style-src 'self'; img-src 'self' data: https://mc.yandex.ru; connect-src 'self' https://cloudflareinsights.com https://mc.yandex.ru; frame-src https://challenges.cloudflare.com blob: https://mc.yandex.ru; child-src blob: https://mc.yandex.ru; worker-src 'self' blob:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'

# Шрифты и картинки оформления меняются редко
/assets/*
  Cache-Control: public, max-age=86400

# Скрипты и стили браузер проверяет при каждом открытии (ответ 304 по ETag, если файл не менялся).
# Скрипты подключают друг друга (import "./app.js") без ?v=: долгий кеш оставил бы после выкладки старый app.js
# рядом с новыми скриптами страниц
/assets/*.js
  Cache-Control: no-cache

/assets/*.css
  Cache-Control: no-cache

# Service worker браузер должен проверять при каждом открытии сайта, иначе обновление сайта дойдёт с опозданием
/sw.js
  Cache-Control: no-cache

/manifest.webmanifest
  Cache-Control: public, max-age=3600

/icons/*
  Cache-Control: public, max-age=86400

/favicon.ico
  Cache-Control: public, max-age=86400

/favicon.svg
  Cache-Control: public, max-age=86400

/offline
  X-Robots-Tag: noindex

# Страницы аккаунта не нужны в поиске
/auth
  X-Robots-Tag: noindex

/profile
  X-Robots-Tag: noindex

/admin
  X-Robots-Tag: noindex

/reset
  X-Robots-Tag: noindex
