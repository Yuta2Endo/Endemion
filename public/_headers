# Заголовки для статических файлов Cloudflare Pages.
# На ответы Functions (/api/*, /title/*) этот файл не действует: там заголовки ставит functions/_lib/html.js

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000
  Content-Security-Policy: default-src 'self'; script-src 'self' https://challenges.cloudflare.com https://static.cloudflareinsights.com; style-src 'self'; img-src 'self' data:; connect-src 'self' https://cloudflareinsights.com; frame-src https://challenges.cloudflare.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'

/assets/*
  Cache-Control: public, max-age=3600

# Страницы аккаунта не нужны в поиске
/auth
  X-Robots-Tag: noindex

/profile
  X-Robots-Tag: noindex
