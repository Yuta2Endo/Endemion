# Endemion Auth — настройки централизованного провайдера авторизации
# Скопируйте в .env: cp auth/.env.example auth/.env

# Адрес провайдера (без https://). В production задайте auth.endemion.online
ISSUER=auth.endemion.online
# Полный URL для локальной разработки
PUBLIC_URL=http://localhost:3001

# База данных аккаунтов Endemion ID
AUTH_DB_FILE=../data/auth.sqlite
# Секреты для подписи cookie и токенов (сгенерируйте случайные строки >= 32 символов)
COOKIE_SECRET=change-me-in-production-min-32-chars
TOKEN_SECRET=change-me-in-production-min-32-chars

# Клиенты OAuth/OIDC (зарегистрированные приложения)
# Формат: CLIENT_ID:CLIENT_SECRET:REDIRECT_URI, через | несколько клиентов
OIDC_CLIENTS=endemion-web:dev-secret-change-in-prod:https://endemion.online/auth/callback|endemion-life-web:dev-secret-change-in-prod:https://life.endemion.online/auth/callback

# Отправка писем (опционально, для подтверждения email и восстановления пароля)
MAIL_FROM=
UNISENDER_API_KEY=
UNISENDER_API_URL=
RESEND_API_KEY=
# 1 — письма в ./mail-outbox (для разработки)
MAIL_DEV_MODE=

# Защита от спама
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Логи
LOG_LEVEL=info
NODE_ENV=development
