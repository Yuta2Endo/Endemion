# Endemion ID (auth.endemion.online). Для разработки: cp auth/.env.example auth/.env, затем npm run dev в auth/.
# На сервере эти строки добавляются в общий .env сайта с префиксом из docker-compose.yml (см. docs/ENDEMION_DEPLOYMENT.md)

# Адрес провайдера без пути. Попадает в ID token как iss, сайты сверяют его при каждом входе
AUTH_ISSUER=http://localhost:3001

# Папка данных: auth.sqlite, ключ подписи auth-jwks.json, аватары, копии базы. Пусто — ../data/auth
# AUTH_DATA_DIR=

# Ключи подписи cookie через запятую, каждый от 32 символов: openssl rand -hex 32.
# Новый ключ ставится первым, старый остаётся вторым на время смены — так входы не сбрасываются
AUTH_COOKIE_KEYS=

# Ключ подписи токенов (RS256). Пусто — в разработке создаётся сам в папке данных.
# В рабочей среде обязателен: npm run keys -- /путь/auth-jwks.json, затем AUTH_JWKS_FILE=/путь/auth-jwks.json
# AUTH_JWKS_FILE=

# Сайты, которые входят через Endemion ID. JSON-массив, одна строка. Секреты: openssl rand -hex 32.
# Адреса только точные, без *, в рабочей среде только https
OIDC_CLIENTS=[{"client_id":"endemion-web","client_secret":"dev-site-secret-change-me-0123456789","platform":"endemion","redirect_uris":["http://127.0.0.1:8788/auth/callback"],"post_logout_redirect_uris":["http://127.0.0.1:8788/"]},{"client_id":"endemion-life-web","client_secret":"dev-life-secret-change-me-0123456789","platform":"endemion_life","redirect_uris":["http://localhost:3000/api/auth/oidc/callback"],"post_logout_redirect_uris":["http://localhost:3000/"]}]

# Адреса сайтов для ссылок на страницах Endemion ID
ENDEMION_URL=http://127.0.0.1:8788
ENDEMION_LIFE_URL=http://localhost:3000

# Письма: unisender | resend | outbox (файлы в папке данных/outbox, только разработка) | none.
# Пусто — unisender при UNISENDER_API_KEY, resend при RESEND_API_KEY, иначе outbox (разработка) или none (рабочая среда)
# MAIL_DRIVER=
MAIL_FROM=
UNISENDER_API_KEY=
UNISENDER_API_URL=
MAIL_SKIP_UNSUBSCRIBE=
RESEND_API_KEY=

# 1 — за обратным прокси (Caddy): адрес посетителя и https берутся из X-Forwarded-*
TRUST_PROXY=

# ---------- Вход через Google, VK ID, GitHub и Discord ----------
# Провайдер включён, если заданы его ключи; без них кнопки нет. Секреты хранятся только здесь, в браузер не попадают.
# Адрес ответа (redirect URI) у провайдера указывается точно: {AUTH_ISSUER}/social/callback/google | vk | github | discord,
# например https://auth.endemion.online/social/callback/google. Подробно — docs/ENDEMION_AUTH_SETUP.md

# Google Cloud Console → APIs & Services → Credentials → OAuth client ID, тип Web application
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=

# GitHub → Settings → Developer settings → OAuth Apps → New OAuth App
AUTH_GITHUB_CLIENT_ID=
AUTH_GITHUB_CLIENT_SECRET=

# VK ID для бизнеса (id.vk.ru) → приложение типа «Веб»: числовой ID приложения
AUTH_VK_CLIENT_ID=
# Сервисный ключ доступа из настроек приложения VK ID. Нужен, если приложение конфиденциальное; пусто — публичное (только PKCE)
AUTH_VK_SERVICE_TOKEN=

# Discord → Developer Portal → Applications → New Application → OAuth2 → Redirects
AUTH_DISCORD_CLIENT_ID=
AUTH_DISCORD_CLIENT_SECRET=

# Яндекс OAuth (oauth.yandex.ru) → создать приложение, права login:info и login:email
AUTH_YANDEX_CLIENT_ID=
AUTH_YANDEX_CLIENT_SECRET=
