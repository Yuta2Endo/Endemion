{
  "name": "endemion",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "db:migrate:local": "wrangler d1 migrations apply endemion --local",
    "db:backup": "node scripts/backup-db.mjs",
    "predb:migrate:remote": "npm run db:backup",
    "db:migrate:remote": "wrangler d1 migrations apply endemion --remote",
    "predeploy": "npm test",
    "deploy": "wrangler deploy",
    "test": "node --test --test-concurrency=1 tests/crypto.test.mjs tests/mail.test.mjs tests/engines.test.mjs tests/platform.test.mjs tests/endemion-id.test.mjs tests/forum.test.mjs tests/studio-admin.test.mjs tests/admin-accounts.test.mjs tests/portal.test.mjs tests/roadmap.test.mjs tests/legal.test.mjs tests/i18n-nav.test.mjs tests/telegram.test.mjs tests/life-assertion.test.mjs",
    "test:auth": "npm --prefix auth test",
    "test:api": "node tests/api.smoke.mjs",
    "test:e2e": "playwright test",
    "start": "node server/index.mjs",
    "db:migrate": "node server/migrate-cli.mjs",
    "seed": "node server/seed.mjs",
    "backup": "node server/backup.mjs",
    "smoke": "node scripts/smoke.mjs",
    "grant-admin": "node server/grant-admin.mjs",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "check": "npm run lint && npm run typecheck && npm test"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/unbounded": "^5.3.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "typescript": "^7.0.2",
    "wrangler": "^4.156.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261023.1": true
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "openid-client": "^6.8.9"
  }
}
