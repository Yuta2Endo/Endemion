{
  "name": "endemion",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "db:migrate:local": "wrangler d1 migrations apply endemion --local",
    "db:backup": "node scripts/backup-db.mjs",
    "predb:migrate:remote": "npm run db:backup",
    "db:migrate:remote": "wrangler d1 migrations apply endemion --remote",
    "predeploy": "npm test",
    "deploy": "wrangler deploy",
    "test": "node --test tests/crypto.test.mjs tests/pages.test.mjs",
    "test:api": "node tests/api.smoke.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.156.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261023.1": true
  }
}
