# Настройки своего сервера. Скопируйте файл в .env и заполните: cp .env.example .env
# Файл .env не попадает в git и в образ Docker: в нём ключи

# Домен сайта без https:// — для сертификата Caddy
SITE_DOMAIN=example.ru
# Адрес сайта целиком: по нему строятся ссылки в письмах и проверяются запросы
PUBLIC_URL=https://example.ru

# Резервные копии базы в data/backups: как часто (часы, 0 — не делать) и сколько хранить
BACKUP_HOURS=24
BACKUP_KEEP=14

# Копии базы ещё и в S3-хранилище (переживут поломку сервера). Пусто — только на диске.
# Бакет должен быть приватным: в копиях почты и хеши паролей. Ключу достаточно прав на запись, чтение и удаление в этом бакете
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_S3_FORCE_PATH_STYLE=
# Сколько копий хранить в бакете
BACKUP_S3_KEEP=30

# ---------- Картинки ----------
# Пусто — картинки хранятся на диске сервера в data/files.
# Для S3-совместимого хранилища (Selectel, Yandex Object Storage, VK Cloud) заполните все строки ниже
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# 1 — адреса вида endpoint/bucket/key (нужно некоторым хранилищам)
S3_FORCE_PATH_STYLE=

# ---------- Демо-данные (npm run seed) ----------
# Тестовый администратор создаётся, только если заданы обе строки. На рабочем сервере оставьте пустыми
# и выдайте права своему аккаунту командой npm run grant-admin -- почта@пример.ру
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# 1 — разрешить seed при NODE_ENV=production (демо-тайтлы попадут в рабочую базу)
SEED_ALLOW_PRODUCTION=

# ---------- Endemion ID (единый аккаунт с life.endemion.online) ----------
# 1 — вход только через auth.endemion.online, старые вход и регистрация паролем закрыты.
# Откат: пусто или 0 и перезапуск app. Подробно — docs/ENDEMION_DEPLOYMENT.md
ENDEMION_ID=
ENDEMION_ID_ISSUER=https://auth.example.ru
ENDEMION_ID_CLIENT_ID=endemion-web
# Тот же секрет, что у клиента endemion-web в OIDC_CLIENTS ниже: openssl rand -hex 32
ENDEMION_ID_CLIENT_SECRET=
# Ключ шифрования refresh token в базе сайта: openssl rand -base64 32. Смена ключа завершит входы через Endemion ID
ENDEMION_ID_TOKEN_KEY=
ENDEMION_LIFE_URL=https://life.example.ru

# Сервис auth (Endemion ID) из docker-compose.yml. Ключи cookie: openssl rand -hex 32, через запятую при смене
AUTH_COOKIE_KEYS=
# Сайты, которые входят через Endemion ID. JSON в одну строку, адреса точные, только https
OIDC_CLIENTS=[{"client_id":"endemion-web","client_secret":"…","platform":"endemion","redirect_uris":["https://example.ru/auth/callback"],"post_logout_redirect_uris":["https://example.ru/"]},{"client_id":"endemion-life-web","client_secret":"…","platform":"endemion_life","redirect_uris":["https://life.example.ru/api/auth/oidc/callback"],"post_logout_redirect_uris":["https://life.example.ru/"]}]
# Отправитель писем Endemion ID. Пусто — MAIL_FROM сайта
AUTH_MAIL_FROM=

# ---------- Каталог энциклопедии ----------
# Источник данных об аниме и манге. Пусто — shikimori (сейчас единственный)
CATALOG_PROVIDER=
# User-Agent запросов к источнику: Shikimori просит указывать название приложения. Пусто — "Endemion (+https://endemion.online)"
CATALOG_USER_AGENT=

# ---------- Необязательно ----------
# Капча Cloudflare Turnstile. Пусто — без капчи
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Письма восстановления пароля. Отправитель на подтверждённом домене, например: Endemion <noreply@example.ru>
MAIL_FROM=
# Ключ Unisender Go. Пусто (и пусто RESEND_API_KEY) — восстановление пароля выключено
UNISENDER_API_KEY=
# Адрес API своего дата-центра Unisender Go, если общий не подходит: https://go1.unisender.ru/ru/transactional/api/v1
UNISENDER_API_URL=
# 1 — письма без ссылки «Отписаться». Сначала включите это в поддержке Unisender Go, иначе письма не уйдут
MAIL_SKIP_UNSUBSCRIBE=
# Вместо Unisender Go можно Resend (США)
RESEND_API_KEY=
# Номер счётчика Яндекс Метрики (только цифры). Метрика загружается только после согласия посетителя
YANDEX_METRIKA_ID=
# Cloudflare Web Analytics. Пусто — не используется
WEB_ANALYTICS_TOKEN=
