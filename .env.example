# Настройки своего сервера. Скопируйте файл в .env и заполните: cp .env.example .env
# Файл .env не попадает в git и в образ Docker: в нём ключи

# Домен сайта без https:// — для сертификата Caddy
SITE_DOMAIN=example.ru
# Адрес сайта целиком: по нему строятся ссылки в письмах и проверяются запросы
PUBLIC_URL=https://example.ru

# Резервные копии базы в data/backups: как часто (часы, 0 — не делать) и сколько хранить
BACKUP_HOURS=24
BACKUP_KEEP=14

# Копии базы ещё и в S3-хранилище (переживут поломку сервера). Пусто — только на диске.
# Бакет должен быть приватным: в копиях почты и хеши паролей. Ключу достаточно прав на запись, чтение и удаление в этом бакете
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_S3_FORCE_PATH_STYLE=
# Сколько копий хранить в бакете
BACKUP_S3_KEEP=30

# ---------- Картинки ----------
# Пусто — картинки хранятся на диске сервера в data/files.
# Для S3-совместимого хранилища (Selectel, Yandex Object Storage, VK Cloud) заполните все строки ниже
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# 1 — адреса вида endpoint/bucket/key (нужно некоторым хранилищам)
S3_FORCE_PATH_STYLE=

# ---------- Необязательно ----------
# Капча Cloudflare Turnstile. Пусто — без капчи
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Письма восстановления пароля через Resend. Пусто — восстановление выключено
RESEND_API_KEY=
MAIL_FROM=
# Cloudflare Web Analytics. Пусто — статистика не собирается
WEB_ANALYTICS_TOKEN=
