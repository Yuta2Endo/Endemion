# Caddy принимает запросы на 80 и 443, сам получает и продлевает сертификат Let's Encrypt
# и передаёт запросы приложению. Домен берётся из SITE_DOMAIN в .env

{$SITE_DOMAIN} {
	encode zstd gzip

	# Страница главы до 15 МБ
	request_body {
		max_size 20MB
	}

	reverse_proxy app:3000 {
		# Caddy заменяет X-Forwarded-For своим значением: подставить чужой IP посетитель не сможет
		header_up X-Forwarded-For {remote_host}
	}
}

# Адрес с www ведёт на основной
www.{$SITE_DOMAIN} {
	redir https://{$SITE_DOMAIN}{uri} permanent
}

# Endemion ID — сервис auth из этого же docker-compose.yml. Нужна A-запись auth.<домен> на этот сервер
auth.{$SITE_DOMAIN} {
	encode zstd gzip

	# Самая большая загрузка — аватар до 2 МБ
	request_body {
		max_size 3MB
	}

	reverse_proxy auth:3001 {
		header_up X-Forwarded-For {remote_host}
	}
}

# Endemion Life — отдельный проект в /opt/endemion-life. Его Nginx подключён к сети endemion_default
# под именем endemion-life-nginx; сжатие и лимиты запросов делает он сам
life.{$SITE_DOMAIN} {
	reverse_proxy endemion-life-nginx:80 {
		header_up X-Forwarded-For {remote_host}
	}
}

# Endemion City staging — separate project in /opt/endemion-city-staging. Its web container is attached to
# endemion_default as endemion-city-staging-web; nothing else of that project joins this network
staging.endemion.online {
	reverse_proxy endemion-city-staging-web:8080 {
		header_up X-Forwarded-For {remote_host}
	}
}
